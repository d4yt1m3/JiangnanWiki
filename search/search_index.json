{"config":{"lang":["zh","en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6b22\u8fce","text":"<p>\u6b22\u8fce\u6765\u5230\u6c5f\u5357\u5927\u5b66Wiki\uff01</p>"},{"location":"about/","title":"\u5173\u4e8e JiangnanWiki","text":"<p>JiangnanWiki \u662f\u4e00\u4e2a\u4f7f\u7528 Material for MkDocs \u6784\u5efa\u7684\u9759\u6001\u77e5\u8bc6\u5e93\u3002</p>"},{"location":"about/#_1","title":"\u5982\u4f55\u8d21\u732e","text":"<ol> <li>\u5728 <code>docs/</code> \u76ee\u5f55\u4e2d\u521b\u5efa\u6216\u4fee\u6539 Markdown \u6587\u4ef6\u3002</li> <li>\u66f4\u65b0 <code>mkdocs.yml</code> \u4e2d\u7684\u5bfc\u822a\u914d\u7f6e\u3002</li> <li>\u63d0\u4ea4\u5e76\u63a8\u9001\u5230 <code>master</code> \u5206\u652f\u3002</li> <li>GitHub Actions \u4f1a\u81ea\u52a8\u6784\u5efa\u5e76\u90e8\u7f72\u7f51\u7ad9\u3002</li> </ol>"},{"location":"about/#_2","title":"\u672c\u5730\u9884\u89c8","text":"<pre><code>uv sync\nuv run mkdocs serve\n</code></pre> <p>\u6d4f\u89c8\u5668\u8bbf\u95ee <code>http://127.0.0.1:8000</code>\u3002</p>"},{"location":"%E7%A7%91%E5%88%9B%E4%BF%B1%E4%B9%90%E9%83%A8/%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%B8%8E%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%AD%A6%E9%99%A2/ACM%E4%BF%B1%E4%B9%90%E9%83%A8/","title":"ACM \u4ff1\u4e50\u90e8","text":"<p>ACM \u4ff1\u4e50\u90e8\u662f\u5b66\u9662\u4e94\u5927\u4ff1\u4e50\u90e8\u4e4b\u4e00\uff0c\u805a\u7126\u7b97\u6cd5\u7ade\u8d5b\u4e0e\u7a0b\u5e8f\u8bbe\u8ba1\uff0c\u4e3a\u6210\u5458\u63d0\u4f9b\u7cfb\u7edf\u8bad\u7ec3\u4e0e\u5b9e\u6218\u7ade\u6280\u5e73\u53f0\u3002</p> <p>\u6210\u5458\u53ef\u4ee5\u51ed\u501f\u84dd\u6865\u676f\u3001\u5929\u68af\u8d5b\u3001XCPC\u3001CSP \u7b49\u8d5b\u4e8b\u6210\u7ee9\u83b7\u5f97\u4fdd\u7814\u52a0\u5206\uff0c\u5386\u5c4a\u5b66\u957f\u5b66\u59d0\u5177\u6709\u4e30\u5bcc\u7684\u4fdd\u7814\u7ecf\u9a8c\u3002</p> <p>\u7814\u7a76\u65b9\u5411\u6db5\u76d6\uff1a</p> <ul> <li>\u6570\u636e\u7ed3\u6784</li> <li>\u56fe\u8bba</li> <li>\u52a8\u6001\u89c4\u5212</li> <li>\u8ba1\u7b97\u51e0\u4f55</li> <li>\u5176\u4ed6\u524d\u6cbf\u7b97\u6cd5</li> </ul>"},{"location":"%E7%A7%91%E5%88%9B%E4%BF%B1%E4%B9%90%E9%83%A8/%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%B8%8E%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%AD%A6%E9%99%A2/%E4%BF%A1%E6%81%AF%E5%AE%89%E5%85%A8%E4%BF%B1%E4%B9%90%E9%83%A8/","title":"\u4fe1\u606f\u5b89\u5168\u4ff1\u4e50\u90e8","text":"<p>\u4fe1\u606f\u5b89\u5168\u4ff1\u4e50\u90e8\u662f\u4e00\u4e2a\u4e13\u6ce8\u4e8e\u7f51\u7edc\u5b89\u5168\u3001\u6570\u636e\u9632\u62a4\u4e0e\u9ed1\u5ba2\u6280\u672f\u7684\u6280\u672f\u793e\u7fa4\u3002</p> <p>\u5728\u8fd9\u91cc\uff0c\u6210\u5458\u53ef\u4ee5\uff1a</p> <ul> <li>\u63a2\u7d22\u6f0f\u6d1e\u653b\u9632</li> <li>\u5b66\u4e60\u5b89\u5168\u8fd0\u7ef4</li> <li>\u7814\u7a76\u52a0\u5bc6\u7b97\u6cd5</li> <li>\u53c2\u52a0 CTF \u7ade\u8d5b</li> <li>\u53c2\u4e0e\u6280\u672f\u6c99\u9f99\u548c\u5b9e\u6218\u6f14\u7ec3</li> </ul> <p>\u4ff1\u4e50\u90e8\u901a\u8fc7\u5b66\u4e60\u4e0e\u5b9e\u8df5\u5e2e\u52a9\u6210\u5458\u63d0\u5347\u4fe1\u606f\u5b89\u5168\u6280\u80fd\u3002</p>"},{"location":"%E7%A7%91%E5%88%9B%E4%BF%B1%E4%B9%90%E9%83%A8/%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%B8%8E%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%AD%A6%E9%99%A2/%E6%95%B0%E5%AD%97%E5%AA%92%E4%BD%93%E4%BF%B1%E4%B9%90%E9%83%A8/","title":"\u6570\u5b57\u5a92\u4f53\u4ff1\u4e50\u90e8","text":"<p>\u6570\u5b57\u5a92\u4f53\u4ff1\u4e50\u90e8\u4e3b\u8981\u7814\u7a76\u4ee5\u4e0b\u65b9\u5411\uff1a</p> <ul> <li>\u6e38\u620f\u5f00\u53d1</li> <li>\u4ea4\u4e92\u8bbe\u8ba1</li> <li>\u4eba\u5de5\u667a\u80fd\u5e94\u7528</li> <li>\u667a\u80fd\u4ea4\u4e92</li> </ul> <p>\u6b22\u8fce\u5bf9\u8fd9\u4e9b\u65b9\u5411\u611f\u5174\u8da3\u6216\u5177\u6709\u76f8\u5173\u7ecf\u9a8c\u7684\u540c\u5b66\u53c2\u4e0e\u3002</p>"},{"location":"%E7%A7%91%E5%88%9B%E4%BF%B1%E4%B9%90%E9%83%A8/%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%B8%8E%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%AD%A6%E9%99%A2/%E6%98%87%E8%85%BE%E9%B2%B2%E9%B9%8FAI%E5%88%9B%E6%96%B0%E4%BF%B1%E4%B9%90%E9%83%A8/","title":"\u6607\u817e\u9cb2\u9e4f AI \u521b\u65b0\u4ff1\u4e50\u90e8","text":"<p>\u4e3a\u63d0\u9ad8\u5b66\u751f\u521b\u65b0\u5b9e\u8df5\u80fd\u529b\uff0c\u4f9d\u6258\u534e\u4e3a ICT \u5b66\u9662\u548c\u534e\u4e3a\u667a\u80fd\u57fa\u5ea7\uff0c\u5b66\u9662\u6210\u7acb\u4e86\u6607\u817e\u9cb2\u9e4f AI \u521b\u65b0\u4ff1\u4e50\u90e8\u3002</p>"},{"location":"%E7%A7%91%E5%88%9B%E4%BF%B1%E4%B9%90%E9%83%A8/%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%B8%8E%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%AD%A6%E9%99%A2/%E6%98%87%E8%85%BE%E9%B2%B2%E9%B9%8FAI%E5%88%9B%E6%96%B0%E4%BF%B1%E4%B9%90%E9%83%A8/#_1","title":"\u4ff1\u4e50\u90e8\u521b\u65b0\u8bad\u7ec3\u6d3b\u52a8","text":"<ol> <li>\u7ec4\u7ec7\u57f9\u8bad\u548c\u53c2\u52a0\u201c\u534e\u4e3a ICT \u5927\u8d5b\u201d\uff08\u5b66\u6821\u8ba4\u5b9a A3 \u7c7b\u7ade\u8d5b\uff09\u3002</li> <li>\u53c2\u52a0\u201c\u534e\u4e3a\u6607\u817e AI \u521b\u65b0\u5927\u8d5b\u201d\uff082022 \u5e74\u9996\u5c4a\uff09\u3002</li> <li>\u53c2\u52a0\u201c\u534e\u4e3a\u9cb2\u9e4f\u521b\u65b0\u5927\u8d5b\u201d\uff082020 \u5e74\u9996\u5c4a\uff09\u3002</li> <li>\u652f\u6491\u5b66\u9662\u6691\u671f\u5f00\u53d1\u677f\u8bad\u7ec3\u8425\u3002</li> <li>\u652f\u6491\u5b66\u9662\u4eba\u5de5\u667a\u80fd\u76f8\u5173\u5b9e\u9a8c\u8bfe\uff08\u534e\u4e3a\u6607\u817e\u3001\u9cb2\u9e4f\u5f00\u53d1\u677f\u76f8\u5173\uff09\u3002</li> <li>\u652f\u6491\u5168\u4f53\u5e08\u751f\u5bf9\u534e\u4e3a\u6607\u817e\u3001\u9cb2\u9e4f\u5f00\u53d1\u677f\u7684\u65e5\u5e38\u4f7f\u7528\u3002</li> </ol>"},{"location":"%E7%A7%91%E5%88%9B%E4%BF%B1%E4%B9%90%E9%83%A8/%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%B8%8E%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%AD%A6%E9%99%A2/%E6%99%BA%E8%83%BD%E7%B3%BB%E7%BB%9F%E4%BF%B1%E4%B9%90%E9%83%A8/","title":"\u667a\u80fd\u7cfb\u7edf\u4ff1\u4e50\u90e8","text":"<p>\u667a\u80fd\u7cfb\u7edf\u4ff1\u4e50\u90e8\u662f\u5b66\u9662\u4e94\u5927\u4ff1\u4e50\u90e8\u4e4b\u4e00\uff0c\u805a\u7126\u673a\u5668\u5b66\u4e60\u3001\u6df1\u5ea6\u5b66\u4e60\u7b49\u4eba\u5de5\u667a\u80fd\u9886\u57df\uff0c\u4e3a\u6210\u5458\u63d0\u4f9b\u4e13\u4e1a\u7684\u5b66\u4e60\u4e0e\u5b9e\u8df5\u5e73\u53f0\u3002</p> <p>\u7814\u7a76\u65b9\u5411\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\uff1a</p> <ul> <li>\u6570\u636e\u6316\u6398</li> <li>\u673a\u5668\u5b66\u4e60</li> <li>\u6df1\u5ea6\u5b66\u4e60</li> <li>\u751f\u6210\u56fe\u50cf\u68c0\u6d4b</li> <li>\u5176\u4ed6\u4eba\u5de5\u667a\u80fd\u524d\u6cbf\u77e5\u8bc6</li> </ul>"},{"location":"%E7%A7%91%E5%88%9B%E4%BF%B1%E4%B9%90%E9%83%A8/%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E4%B8%8E%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%AD%A6%E9%99%A2/%E8%AE%A1%E7%AE%97%E6%9C%BA%E7%B3%BB%E7%BB%9F%E4%BF%B1%E4%B9%90%E9%83%A8/","title":"\u8ba1\u7b97\u673a\u7cfb\u7edf\u4ff1\u4e50\u90e8","text":"<p>\u8ba1\u7b97\u673a\u7cfb\u7edf\u4ff1\u4e50\u90e8\u4e3b\u653b\u8ba1\u7b97\u673a\u7cfb\u7edf\u5e95\u5c42\u8bbe\u8ba1\u3001CPU \u8bbe\u8ba1\u3001FPGA \u5f00\u53d1\u548c\u8f6f\u786c\u4ef6\u534f\u540c\u8bbe\u8ba1\u3002</p> <p>\u6210\u5458\u53ef\u4ee5\u53c2\u4e0e\u5404\u7c7b\u7cfb\u7edf\u8bbe\u8ba1\u7ade\u8d5b\uff0c\u4f8b\u5982\uff1a</p> <ul> <li>\u5d4c\u5165\u5f0f\u82af\u7247\u4e0e\u7cfb\u7edf\u8bbe\u8ba1\u5927\u8d5b</li> <li>\u8ba1\u7b97\u673a\u7cfb\u7edf\u80fd\u529b\u5927\u8d5b</li> <li>\u5176\u4ed6\u8f6f\u786c\u4ef6\u7cfb\u7edf\u8bbe\u8ba1\u7ade\u8d5b</li> </ul> <p>\u4ff1\u4e50\u90e8\u4e0d\u4ec5\u5173\u6ce8\u7ade\u8d5b\u5b9e\u8df5\uff0c\u4e5f\u652f\u6301\u6210\u5458\u5f00\u5c55\u79d1\u7814\u5de5\u4f5c\uff0c\u4ea7\u51fa\u8bba\u6587\u5e76\u7533\u8bf7\u3001\u53d1\u8868\u4e13\u5229\u3002</p> <p>\u6b22\u8fce\u5bf9\u8ba1\u7b97\u673a\u786c\u4ef6\u548c\u5e95\u5c42\u7cfb\u7edf\u611f\u5174\u8da3\u7684\u540c\u5b66\u52a0\u5165\u3002</p>"}]}